<table class="table table-cv table-sm table-borderless table-responsive table-cv-map">
  {% assign skip_basics = 'image,profiles,location' | split: ',' %}
  {% for content in data[1] %}
    {%
      if (content[1] == "") or (skip_basics contains
      content[0])
    %}
      {% continue %}
    {% endif %}

    <tr>
      <td class="p-1 pr-2 font-weight-bold">
        <b>{{ content[0] | capitalize }}</b>
      </td>
      <td class="p-1 pl-2 font-weight-light text">
        {% if content[0] == 'url' %}
          <a href="{{ content[1] }}" target="_blank" rel="noopener noreferrer">{{ content[1] }}</a>
        {% elsif content[0] == 'email' %}
          <a href="mailto:{{ content[1] }}" target="_blank">{{ content[1] }}</a>
        {% elsif content[0] == 'phone' %}
          <a href="tel:{{ content[1] }}">{{ content[1] }}</a>
        {% else %}
          {{ content[1] }}
        {% endif %}
      </td>
    </tr>
  {% endfor %}
  {% assign loc = data[1].location %}
  {% if loc %}
    {% assign loc_parts = '' | split: '' %}
    {% if loc.city %}{% assign loc_parts = loc_parts | push: loc.city %}{% endif %}
    {% if loc.region %}{% assign loc_parts = loc_parts | push: loc.region %}{% endif %}
    {% if loc.countryCode %}{% assign loc_parts = loc_parts | push: loc.countryCode %}{% endif %}
    <tr>
      <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>
      <td class="p-1 pl-2 font-weight-light text">{{ loc_parts | join: ', ' }}</td>
    </tr>
  {% endif %}
  {% for profile in data[1].profiles %}
    <tr>
      <td class="p-1 pr-2 font-weight-bold">
        <b>{{ profile.network }}</b>
      </td>
      <td class="p-1 pl-2 font-weight-light text">
        <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer">{{ profile.username }}</a>
      </td>
    </tr>
  {% endfor %}
</table>
